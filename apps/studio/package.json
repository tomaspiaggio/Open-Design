{
  "name": "@opendesign/studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --kill-others-on-fail --kill-signal SIGINT \"node --import tsx/esm src/server.ts\" \"vite\"",
    "dev:api": "tsx src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/workspace.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@opendesign/acme-system": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.66.8",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "ai": "^7.0.142",
    "dotenv": "^18.0.8",
    "hono": "^4.7.2",
    "jszip": "^3.10.2",
    "playwright": "^1.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "vite": "^6.3.5"
  }
}
